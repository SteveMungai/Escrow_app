# Copy to backend/.env for local development. NEVER commit the real .env.

# Supabase -> Connect -> "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD].
# If the password has special characters (@ : / # ?), URL-encode them (@ -> %40).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Only used by the Vite dev server setup (localhost:5173). Not needed on Vercel (same origin).
CORS_ORIGINS=http://localhost:5173
SQL_ECHO=false
